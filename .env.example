# Jira Cloud connection (the API token stays server-side; never commit .env)
JIRA_SITE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Custom field id holding the "Engineering Manager" value (run `npm run discover:fields`)
JIRA_EM_FIELD=customfield_10000
# Saved Jira filter id used by the Support page
JIRA_SUPPORT_FILTER_ID=10001

# Cache backend: "local" (JSON files) or "s3"
CACHE_BACKEND=local
LOCAL_CACHE_DIR=.cache
AWS_REGION=us-east-1
JIRA_CACHE_BUCKET=
JIRA_SETTINGS_TABLE=

# Optional overrides for `npm run smoke:live`
# JIRA_TEAM_MEMBERS="a@example.com\nb@example.com"
# JIRA_TRACKED_ITEMS="board:101 Platform Core\nfilter:10001 Support"
